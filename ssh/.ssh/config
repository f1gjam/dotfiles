Host 192.168.1.12
    HostName 192.168.1.12
    User root

Host Bitbucket
    HostName bitbucket.org
    User kashif.ali@anywhere.re
    Port 22
    IdentityFile ~/.ssh/id_ed25519_kashif_compass

Host github-work
  HostName github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519_kashif_compass

Host gitlab.com
    HostName gitlab.com
    AddKeysToAgent yes
    UseKeychain yes
    User git
    IdentityFile ~/.ssh/id_github  # <-- Point to your custom key file

Host github-personal
  HostName github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_github

Host *
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_github
  SetEnv TERM=xterm-256color
